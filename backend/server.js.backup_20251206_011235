// Função para gerar código único
const gerarCodigoLead = async () => {
  const hoje = new Date();
  const data = hoje.toISOString().slice(0,10).replace(/-/g, '');
  const prefixo = 'LEAD-' + data + '-';
  
  // Buscar último código do dia
  const result = await pool.query(
    "SELECT codigo FROM clientes_finais WHERE codigo LIKE $1 ORDER BY codigo DESC LIMIT 1",
    [prefixo + '%']
  );
  
  let sequencial = 1;
  if (result.rows.length > 0) {
    const ultimoCodigo = result.rows[0].codigo;
    const ultimoNum = parseInt(ultimoCodigo.split('-')[2]) || 0;
    sequencial = ultimoNum + 1;
  }
  
  return prefixo + String(sequencial).padStart(5, '0');
};

